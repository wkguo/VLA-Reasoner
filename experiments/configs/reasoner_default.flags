# VLA-Reasoner hyper-parameters (absl flagfile; one flag per line, comments on their own lines).
# Default hyper-parameters (alpha = 0.6 and c = 1/sqrt(2) as in the paper).
--alpha=0.6
--c_ucb=0.7071067811865476
# MaxDepth of Algorithm 1; the loop runs d = 0..MaxDepth
--max_depth=2
# k candidates per expansion
--top_k=5
# N KDE samples per expansion (N large, k small)
--num_kde_samples=1000
# search interval in VLA queries (1 = search at every query)
--search_interval=1
--sampler=kde
--value=image
--world_model=ivideogpt
# iVideoGPT settings of its action-conditioned fine-tuning recipes (context 2, segment 12, 64x64)
--wm_context_length=2
--wm_segment_length=12
--wm_resolution=64
